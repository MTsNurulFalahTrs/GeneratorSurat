{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "js/**/*.js",
    "js/**/*.d.ts",
    "api/**/*.js",
    "templates/**/*.js"
  ],
  "exclude": [
    "js/vendor/**",
    "node_modules/**"
  ]
}
