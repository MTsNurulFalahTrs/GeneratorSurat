{
  "name": "generator-surat",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm run check:syntax && npm run check:types && npm test",
    "check:types": "node scripts/check-types.js",
    "check:types:raw": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.1.0",
    "typescript": "5.8.3"
  }
}
